# Scheduling voice assistant local environment
#
# Usage:
#   cp .env.scheduling.example .env.scheduling
#   DOTENV_FILE=.env.scheduling PYTHONPATH=$(pwd) python api/main.py

# Domain selector
DOMAIN=scheduling
APP_NAME=adar-scheduling-api
APP_ENV=development
PORT=8040

# Google / Gemini
# Required for ADK agent calls (STT/TTS + the scheduling_agent's tool calls).
GOOGLE_API_KEY=
GCP_PROJECT_ID=bdas-493785
ADK_MODEL=gemini-2.5-flash

# Scheduling Firestore
# Required for everything — this domain has no Postgres component, unlike
# restaurants. Create this Firestore database (native mode) before running
# ingestion or the backend.
FIRESTORE_DATABASE=adar-scheduling-db
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Auth/teams database
# auth.py's _auth_db() hardcodes this per domain and doesn't have a
# "scheduling" case, so without this it silently falls back to tigers-arcl
# (ARCL's database) — team signups would land there instead of here.
AUTH_FIRESTORE_DATABASE=adar-scheduling-db

# ADK session storage
# Local SQLite is fine for development. Use Postgres in production.
SESSION_DB_URL=sqlite+aiosqlite:///./scheduling_sessions.db

# Auth / API key
JWT_SECRET=change-me-in-local-dev
ADMIN_EMAIL=
ADMIN_PASSWORD=
SCHEDULING_API_KEY=

# Default practice (single-practice pilot)
# Set this to the practice_id printed by run_ingestion.py so callers never
# have to state which practice they mean. Leave blank for a multi-practice
# deployment that resolves practice_id from caller session/auth context
# instead — see domains/scheduling/README.md.
SCHEDULING_DEFAULT_PRACTICE_ID=

# Firestore collection name overrides (optional)
# Already default correctly (scheduling_practices, scheduling_providers,
# etc.) — only set these if you need non-default collection names, e.g. to
# share one Firestore database across multiple deployments.
SCHEDULING_PRACTICES_COLLECTION=
SCHEDULING_PROVIDERS_COLLECTION=
SCHEDULING_APPOINTMENT_TYPES_COLLECTION=
SCHEDULING_APPOINTMENTS_COLLECTION=
SCHEDULING_HOLDS_COLLECTION=

# Billing — not yet wired for this domain (see build plan §5). Left blank
# for convention-consistency with the other domain example files.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SCHEDULING=

# Evaluation
EVAL_ENABLED=true

# Frontend
FRONTEND_URL=http://localhost:5173
