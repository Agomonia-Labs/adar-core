# Restaurant recommender local environment
#
# Usage:
#   cp .env.restaurants.example .env.restaurants
#   DOTENV_FILE=.env.restaurants PYTHONPATH=$(pwd) python api/main.py

# Domain selector
DOMAIN=restaurants
APP_NAME=adar-restaurants-api
APP_ENV=development
PORT=8040

# Google / Gemini
# Required for ADK agent calls and menu/review embeddings.
GOOGLE_API_KEY=AIzaSyDYDRRB3Geuje0yEd0WA8hFGu9GVjU2nbQ
GCP_PROJECT_ID=bdas-493785
ADK_MODEL=gemini-2.5-flash

# Restaurant Postgres
# Required for ingestion and hybrid search.
# Database should have pgvector, postgis, pg_trgm, and pgcrypto available.
#RESTAURANTS_DATABASE_URL=postgresql://user:password@localhost:5432/restaurants
#RESTAURANTS_DATABASE_URL=postgresql://docintel:docintel_secret@postgres:5432/restaurants
RESTAURANTS_DATABASE_URL=postgresql://adar:adar12@localhost:5432/restaurants

# ADK session storage
# Local SQLite is fine for development. Use Postgres in production.
SESSION_DB_URL=sqlite+aiosqlite:///./restaurants_sessions.db

# Auth / API key
JWT_SECRET=83fe18b24488d033ff130e8c3f8c24195f5418fde3dbd20c3e9bcfeed5ecd3fe   # openssl rand -hex 32
ADMIN_EMAIL=admin@adar.agomoniai.com
ADMIN_PASSWORD=16706fe00ad5339bee522a174d39823a52aa51b8
RESTAURANTS_API_KEY=96adb46fcd5997ad375eb9fff7c59dc8f0183fcd673b43531f491b87ea5aa3cf          # openssl rand -hex 32
BILLING_ENABLED=false

# Optional external data providers for later ingestion increments.
GOOGLE_PLACES_API_KEY=AIzaSyAxI5M1Ba8HN9qAJ-itlyu4aDE82_5BEtc
YELP_API_KEY=

# Optional scraping controls
RESTAURANTS_SCRAPER_USER_AGENT=AdarRestaurantIngestion/0.1
RESTAURANTS_SCRAPER_DELAY_SECONDS=1.0

# Evaluation
EVAL_ENABLED=true

# Frontend
FRONTEND_URL=http://localhost:5173
