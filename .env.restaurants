# Restaurant recommender local environment
#
# Usage:
#   cp .env.restaurants.example .env.restaurants
#   DOTENV_FILE=.env.restaurants PYTHONPATH=$(pwd) python api/main.py

# Domain selector
DOMAIN=restaurants
APP_NAME=adar-restaurants-api
APP_ENV=development
PORT=8040

# Google / Gemini
# Required for ADK agent calls and menu/review embeddings.
GOOGLE_API_KEY=
GCP_PROJECT_ID=bdas-493785
ADK_MODEL=gemini-2.5-flash

# Restaurant Postgres
# Required for ingestion and hybrid search.
# Database should have pgvector, postgis, pg_trgm, and pgcrypto available.
RESTAURANTS_DATABASE_URL=postgresql://user:password@localhost:5432/restaurants

# ADK session storage
# Local SQLite is fine for development. Use Postgres in production.
SESSION_DB_URL=sqlite+aiosqlite:///./restaurants_sessions.db

# Auth / API key
JWT_SECRET=change-me-in-local-dev
ADMIN_EMAIL=
ADMIN_PASSWORD=
RESTAURANTS_API_KEY=

# Optional external data providers for later ingestion increments.
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# Optional scraping controls
RESTAURANTS_SCRAPER_USER_AGENT=AdarRestaurantIngestion/0.1
RESTAURANTS_SCRAPER_DELAY_SECONDS=1.0

# Evaluation
EVAL_ENABLED=true

# Frontend
FRONTEND_URL=http://localhost:5173

